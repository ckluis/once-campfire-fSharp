#!/usr/bin/env bash
# Build with warnings as errors, then run every test. Must pass before work is reported done.
#   bin/verify            build + all tests
#   bin/verify Db Kit     build + only those projects' tests
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.dotnet:$PATH" DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
# NetVips (Campfire.Storage) loads the system libvips by its soname, which macOS only finds on the
# default library path; Homebrew installs it elsewhere. (Linux finds it through ldconfig.)
if [ "$(uname)" = Darwin ] && [ -d /opt/homebrew/lib ]; then
  export DYLD_FALLBACK_LIBRARY_PATH="/opt/homebrew/lib${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
fi
dotnet build CampfireFs.slnx -c Release -warnaserror -v quiet -nologo
if [ $# -eq 0 ]; then
  dotnet test --solution CampfireFs.slnx -c Release --no-build
else
  for p in "$@"; do dotnet test --project "tests/Campfire.$p.Tests" -c Release --no-build; done
fi
