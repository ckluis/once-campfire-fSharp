<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tier 1 of Phase 7's tuning loop for small gzip bodies (unit 7.4): Deflater.gzipMember against the DeflateStream version it replaced,
       in process, in ns and bytes allocated per call. Not in the solution; run it with bench/micro-linux gzip-micro.
       Its numbers compare variants only and are never reported. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Campfire.Kit/Campfire.Kit.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
