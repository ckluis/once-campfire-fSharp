#!/usr/bin/env bash
# Fan-out of Action Cable broadcasts to many local subscribers: Campfire.Cable on Kestrel against
# campfire_cable on axum, serving the same endpoints on loopback (bench/cable/fsharp/Program.fs, bench/cable/rust/src/main.rs),
# driven by bench/cable/driver.py. Per server and mode (plain, and permessage-deflate as browsers offer it): memory
# per idle client, latency of one broadcast to every client, and the server's CPU time per delivered message in a
# burst. It needs python3, the .NET SDK and (for the Rust side) cargo via mise.
#
#   bench/cable/run [fsharp|rust|both] [--clients 1000] [--bytes 600] [--rounds 60] [--burst 200] [--reps 1] [--tuned]
#
# --tuned runs the F# server with the thread pool's workers not spinning (DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=0), which a
# fan-out wave of short continuations otherwise spends a good part of its CPU on, and with Kestrel's socket transport running its
# sends where the write is made (UnsafePreferInlineScheduling, which the bench server turns on with CABLE_INLINE=1). Both are
# settings of the host the cable is mounted in, not of the cable. The burst is at most the stream capacity (256).
#
# The F# server is built from bench/cable/fsharp and the Rust one from bench/cable/rust (with rust/Cargo.lock beside it,
# so that it builds offline against what rust/ already fetched); both land under target/cable-bench.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
OUT=$ROOT/target/cable-bench
which=${1:-both}
[ $# -gt 0 ] && shift
CLIENTS=1000 BYTES=600 ROUNDS=60 BURST=200 REPS=1 TUNED=0 PORT=${PORT:-4410}
while [ $# -gt 0 ]; do
  case $1 in
    --clients) CLIENTS=$2; shift 2 ;;
    --bytes) BYTES=$2; shift 2 ;;
    --rounds) ROUNDS=$2; shift 2 ;;
    --burst) BURST=$2; shift 2 ;;
    --reps) REPS=$2; shift 2 ;;
    --tuned) TUNED=1; shift ;;
    *) echo "unknown option $1"; exit 2 ;;
  esac
done
export PATH="$HOME/.dotnet:$PATH" DOTNET_ROOT="$HOME/.dotnet" DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1
mkdir -p "$OUT"
ulimit -n 65536 2>/dev/null || true

build_fsharp() {
  dotnet build "$ROOT/bench/cable/fsharp" -c Release -v quiet -nologo -o "$OUT/fsharp"
}
build_rust() {
  cp "$ROOT/rust/Cargo.lock" "$ROOT/bench/cable/rust/Cargo.lock"
  (cd "$ROOT/bench/cable/rust" && CARGO_TARGET_DIR="$OUT/rust" mise exec rust -- cargo build --release --offline)
}

run_one() {
  local name=$1; shift
  if [ "$name" = fsharp ] && [ "$TUNED" = 1 ]; then export DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=0 CABLE_INLINE=1; fi
  "$@" "$PORT" &
  local pid=$!
  unset DOTNET_ThreadPool_UnfairSemaphoreSpinLimit CABLE_INLINE
  for _ in $(seq 1 100); do curl -s -o /dev/null "http://127.0.0.1:$PORT/" && break; sleep 0.1; done
  for deflate in 0 1; do
    for rep in $(seq 1 "$REPS"); do
      printf '%-8s deflate=%s ' "$name" "$deflate"
      python3 "$ROOT/bench/cable/driver.py" "$PORT" "$pid" --clients "$CLIENTS" --deflate "$deflate" --bytes "$BYTES" \
        --rounds "$ROUNDS" --burst "$BURST"
    done
  done
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

[ "$which" != rust ] && build_fsharp
[ "$which" != fsharp ] && build_rust
[ "$which" != rust ] && run_one fsharp "$OUT/fsharp/CableBench"
[ "$which" != fsharp ] && run_one rust "$OUT/rust/release/cablebench"
