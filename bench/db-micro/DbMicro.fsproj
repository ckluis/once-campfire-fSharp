<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tier 1 of Phase 7's tuning loop for the database path: Campfire.Db's hot-path queries on one reader connection against a
       copy of the parity seed, in process, in ns and bytes allocated per iteration. Not in the solution; run it in Release
       before and after a change and compare (see Program.fs). Its numbers compare variants only and are never reported. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Campfire.Db/Campfire.Db.fsproj" />
  </ItemGroup>
</Project>
