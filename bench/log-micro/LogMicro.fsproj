<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tier 1 of Phase 7's tuning loop for the request log (unit 7.3): what one request costs the front handler with request logging off,
       through the console logger, and as batched bytes, in process, as CPU time of the whole process (the writer threads included).
       Not in the solution; run it with bench/micro-linux log-micro. Its numbers compare variants only and are never reported. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Campfire.Kit/Campfire.Kit.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
