<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>campfire</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Config.fs" />
    <Compile Include="Concerns/UserAgent.fs" />
    <Compile Include="Concerns/Platform.fs" />
    <Compile Include="Channels/Identity.fs" />
    <Compile Include="Channels/Revocation.fs" />
    <Compile Include="Channels/Connection.fs" />
    <Compile Include="Channels/ReadRooms.fs" />
    <Compile Include="Channels/UnreadRooms.fs" />
    <Compile Include="Channels/Broadcasts.fs" />
    <Compile Include="Channels/Registry.fs" />
    <Compile Include="Jobs.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Campfire.RailsCompat/Campfire.RailsCompat.fsproj" />
    <ProjectReference Include="../Campfire.Ruby/Campfire.Ruby.fsproj" />
    <ProjectReference Include="../Campfire.Kit/Campfire.Kit.fsproj" />
    <ProjectReference Include="../Campfire.Routes/Campfire.Routes.fsproj" />
    <ProjectReference Include="../Campfire.Db/Campfire.Db.fsproj" />
    <ProjectReference Include="../Campfire.RichText/Campfire.RichText.fsproj" />
    <ProjectReference Include="../Campfire.Storage/Campfire.Storage.fsproj" />
    <ProjectReference Include="../Campfire.Cable/Campfire.Cable.fsproj" />
    <ProjectReference Include="../Campfire.Assets/Campfire.Assets.fsproj" />
    <ProjectReference Include="../Campfire.Views/Campfire.Views.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Falco" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Campfire.App.Tests" />
  </ItemGroup>
</Project>
