<Project Sdk="Microsoft.NET.Sdk">
  <!-- The counterpart of crates/assets/build.rs: run by Campfire.Assets before it compiles. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Propshaft.fs" />
    <Compile Include="Importmap.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Campfire.Ruby/Campfire.Ruby.fsproj" />
  </ItemGroup>
</Project>
