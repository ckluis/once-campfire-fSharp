<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/Repo.fs" Link="Repo.fs" />
    <Compile Include="../../reference-tools/views/differential/fsharp/Inputs.fs" Link="Inputs.fs" />
    <Compile Include="../../reference-tools/views/differential/fsharp/Answer.fs" Link="Answer.fs" />
    <Compile Include="../../reference-tools/views/differential/fsharp/Pages.fs" Link="Pages.fs" />
    <Compile Include="../../reference-tools/views/differential/fsharp/Rest.fs" Link="Rest.fs" />
    <Compile Include="../../reference-tools/views/differential/fsharp/Operations.fs" Link="Operations.fs" />
    <Compile Include="Support/Dom.fs" />
    <Compile Include="Support/Facts.fs" />
    <Compile Include="Support/GoldenB.fs" />
    <Compile Include="DomTests.fs" />
    <Compile Include="OutTests.fs" />
    <Compile Include="TagTests.fs" />
    <Compile Include="FormsTests.fs" />
    <Compile Include="HelpersTests.fs" />
    <Compile Include="FragmentCacheTests.fs" />
    <Compile Include="RecordedTests.fs" />
    <Compile Include="MessagesTests.fs" />
    <Compile Include="UsersTests.fs" />
    <Compile Include="ParityATests.fs" />
    <Compile Include="MessagesViewsTests.fs" />
    <Compile Include="RoomsViewsTests.fs" />
    <Compile Include="SearchesViewsTests.fs" />
    <Compile Include="KitIntegrationTests.fs" />
    <Compile Include="DifferentialTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Campfire.Views/Campfire.Views.fsproj" />
    <!-- Only the tests read the DOM: the HTML tokenizer ports the one the Rust crate's dev-dependency is. -->
    <ProjectReference Include="../../src/Campfire.RichText/Campfire.RichText.fsproj" />
    <!-- Only the tests join the two: Campfire.App will, as the Rust app does. See KitIntegrationTests. -->
    <ProjectReference Include="../../src/Campfire.Kit/Campfire.Kit.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
