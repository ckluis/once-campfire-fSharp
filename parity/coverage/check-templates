#!/usr/bin/env ruby
# Template coverage of the screen inventory.
#
#   parity/coverage/check-templates           fail if a template under reference/app/views has no
#                                             covering state (and isn't in exclusions.yml), if a state
#                                             covers a template that doesn't exist, or if
#                                             templates.txt is stale
#   parity/coverage/check-templates --write   regenerate templates.txt
#
# Template names drop the handler extension and an .html format: rooms/show.html.erb is
# "rooms/show", messages/_message.json.jbuilder is "messages/_message.json". That's the form
# `covers:` uses in parity/screens.yml.
require "yaml"

ROOT = File.expand_path("../..", __dir__)
VIEWS = File.join(ROOT, "reference/app/views")
OUT = File.join(__dir__, "templates.txt")

def template_name(path)
  path.delete_prefix("#{VIEWS}/").sub(/\.(erb|jbuilder)\z/, "").sub(/\.html\z/, "")
end

templates = Dir[File.join(VIEWS, "**/*")].select { |f| File.file?(f) }.map { |f| template_name(f) }.sort
exclusions = YAML.load_file(File.join(__dir__, "exclusions.yml"))
states = YAML.load_file(File.join(ROOT, "parity/screens.yml"))

covering = Hash.new { |h, k| h[k] = [] }
unknown = []
states.each do |state|
  Array(state["covers"]).each do |template|
    templates.include?(template) ? covering[template] << state["id"] : unknown << "#{state["id"]}: #{template}"
  end
end

lines = [ "# template -> covering state ids (generated by parity/coverage/check-templates --write)" ]
templates.each do |template|
  lines << if covering[template].any?
    "#{template} -> #{covering[template].uniq.join(" ")}"
  elsif exclusions.key?(template)
    "#{template} -> EXCLUDED: #{exclusions[template]}"
  else
    "#{template} -> UNCOVERED"
  end
end
report = lines.join("\n") + "\n"

if ARGV.include?("--write")
  File.write(OUT, report)
  puts "wrote #{OUT.delete_prefix("#{ROOT}/")}"
end

problems = []
problems += templates.reject { |t| covering[t].any? || exclusions.key?(t) }.map { |t| "uncovered template: #{t}" }
problems += unknown.map { |u| "covers a template that doesn't exist: #{u}" }
problems += (exclusions.keys - templates).map { |t| "exclusion for a template that doesn't exist: #{t}" }
problems += (exclusions.keys & covering.keys.select { |k| covering[k].any? }).map { |t| "excluded but covered: #{t}" }
problems << "templates.txt is stale: run parity/coverage/check-templates --write" if !ARGV.include?("--write") && (!File.exist?(OUT) || File.read(OUT) != report)

if problems.any?
  puts problems
  exit 1
else
  puts "#{templates.size} templates: #{templates.count { |t| covering[t].any? }} covered, #{exclusions.size} excluded"
end
